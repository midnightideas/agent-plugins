#!/bin/bash
set -euo pipefail

# Promote agent-supplied GitHub token and git identity into the session,
# then suppress VS Code's native Git credential helpers.
if [ -n "${AGENT_GITHUB_TOKEN:-}" ]; then
  export GITHUB_TOKEN="$AGENT_GITHUB_TOKEN"
  export GIT_HTTP_HEADER="Authorization: Bearer ${GITHUB_TOKEN}"
  unset VSCODE_GIT_ASKPASS_NODE VSCODE_GIT_ASKPASS_MAIN VSCODE_GIT_ASKPASS_EXTRA_ARGS
  unset GIT_ASKPASS AGENT_GITHUB_TOKEN VSCODE_GIT_IPC_HANDLE
fi

# Git identity — only set if the corresponding AGENT_ var is non-empty
if [ -n "${AGENT_GIT_AUTHOR_NAME:-}" ]; then
  export GIT_AUTHOR_NAME="$AGENT_GIT_AUTHOR_NAME"
  export GIT_COMMITTER_NAME="$AGENT_GIT_AUTHOR_NAME"
  unset AGENT_GIT_AUTHOR_NAME
fi

if [ -n "${AGENT_GIT_AUTHOR_EMAIL:-}" ]; then
  export GIT_AUTHOR_EMAIL="$AGENT_GIT_AUTHOR_EMAIL"
  export GIT_COMMITTER_EMAIL="$AGENT_GIT_AUTHOR_EMAIL"
  unset AGENT_GIT_AUTHOR_EMAIL
fi

exec claude "$@"
